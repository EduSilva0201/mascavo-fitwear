{
  "name": "mascavo-tests-only",
  "main": "../../backend/src/index.ts",
  "compatibility_date": "2026-11-09",
  "workers_dev": false,
  "preview_urls": false,
  "dev": { "ip": "127.0.0.1", "port": 8791 },
  "vars": { "APP_ENV": "local", "APP_ORIGIN": "http://127.0.0.1:8791" },
  "assets": { "directory": "../../dist/public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mascavo-tests-only",
      "database_id": "00000000-0000-0000-0000-000000000099",
      "migrations_dir": "../../backend/migrations",
      "remote": false,
    },
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "mascavo-tests-only", "remote": false }],
}
