  "description": "Loja virtual de moda fitness — protótipo inicial.",
  "scripts": {
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "db:migrate": "node scripts/wrangler-local.mjs migrate",
    "dev": "npm run assets:prepare && node scripts/wrangler-local.mjs dev",
    "typecheck": "tsc --noEmit && npm run typecheck:frontend",
    "test": "node --test tests/auth.test.mjs",
    "check": "npm run typecheck && npm test",
    "build:check": "npm run assets:prepare && node scripts/wrangler-local.mjs build",
    "mail:local": "node scripts/mail-local.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:frontend": "tsc --project tsconfig.frontend.json",
    "rail:build": "node scripts/build-rail.mjs"
  },
