# Copie para .env.sandbox. Nao use credenciais de producao.
# Este arquivo e lido pelos comandos explicitos test:sandbox e test:sandbox:shipping.
RUN_SANDBOX_TESTS=1
SANDBOX_PROVIDER=both
ASAAS_SANDBOX_API_KEY=
MELHOR_ENVIO_SANDBOX_TOKEN=
# Chave de NF-e de teste aceita pelo Melhor Envio Sandbox.
MASCAVO_SANDBOX_NFE_KEY=
# Objeto JSON em uma linha com os dados do remetente da mesma NF-e de homologação.
MASCAVO_SANDBOX_SENDER_JSON=
